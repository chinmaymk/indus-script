  "schema_version": 1,
  "scope": "Bounded fair-attribution check of Pettersson (1999) local t notation; not validation of its numerical meaning.",
  "result": "CXXVII1 upright strokes in a tilted four-mark row are compatible with 7i4t as the author defines t. The previous claim that the drawing challenges an asserted transverse-stroke interpretation is withdrawn.",
  "definition": [
    {
      "printed_page": 89,
      "pdf_page": 1,
      "finding": "Boldface t denotes strokes in tilted rows; numerical prefix indicates repetition count."
    },
    {
      "printed_page": 90,
      "pdf_page": 2,
      "finding": "Rows run at an angle to other stroke rows; special t notation preserves layout missing in standardized sequential rendering. Italic symbols denote hypothetical values."
    }
  ],
  "alternative_and_preference": [
    {
      "printed_page": 98,
      "pdf_page": 10,
      "finding": "Explicitly entertains interpreting tilted four as 4i and calculates t=i."
    },
    {
      "printed_page": 100,
      "pdf_page": 12,
      "finding": "Revisits t=i then asks whether a tilted row should be treated as another ordinary row."
    },
    {
      "printed_page": 101,
      "pdf_page": 13,
      "finding": "DK7857 table reads7i4t. Discussion distinguishes tilted rows; considers four-mark nonnumerical icon alternative."
    },
    {
      "printed_page": 102,
      "pdf_page": 14,
      "finding": "Develops octal interpretation; says small fractional t cannot be tested from these mass equations within preservation uncertainty."
    },
    {
      "printed_page": 106,
      "pdf_page": 18,
      "finding": "Conclusion favors distinguishing t from i, with numerical and nonnumerical four-group alternatives."
    },
    {
      "printed_page": 107,
      "pdf_page": 19,
      "finding": "Requests more objects or inscribed weight units to decide weight hypothesis more securely."
    }
  ],
  "horizontal_claim_audit": {
    "finding": "No explicit assignment of individually horizontal strokes to DK7857 found in inspected definition, table, discussion or conclusion.",
    "scope": "Not a claim of exhaustive absence in all writings or all physical representations."
  },
  "error_record": {
    "earlier_inference": "Upright marks in tilted row were said to challenge later transverse-four assignment.",
    "cause": "Conflation of orientation of individual strokes with orientation of row, and inference from local t abbreviation without checking author definition.",
    "replacement": "Retain drawn geometry; withdraw alleged contradiction to author notation. Numerical value remains unverified."
  },
  "limits": [
    "Compatible terminology does not prove the original object or every depiction has identical geometry.",
